<Window x:Class="RestaurantPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restaurant POS"
        Height="600"
        Width="1000">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Text="{Binding WelcomeMessage}"
            FontSize="32"
            Margin="20"
            Grid.Row="0"/>

        <!-- Main Area -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <StackPanel Grid.Column="0">
                <TextBlock
                    Text="Categories"
                    FontSize="24"
                    Margin="10"/>

                <Button
                    Content="Food"
                    Height="50"
                    Margin="10"/>

                <Button
                    Content="Drinks"
                    Height="50"
                    Margin="10"/>

                <Button
                    Content="Desserts"
                    Height="50"
                    Margin="10"/>
            </StackPanel>

            <!-- Products -->
            <StackPanel Grid.Column="1">

                <TextBlock
        Text="Products"
        FontSize="24"
        Margin="10"/>

                <ItemsControl ItemsSource="{Binding Products}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button
                                Height="70"
                                Margin="10"
                                Command="{Binding DataContext.AddToCartCommand,
                  RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">

                                <StackPanel>

                                    <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="20"
                                    HorizontalAlignment="Center"/>

                                    <TextBlock
                                        Text="{Binding Price, StringFormat=RM {0:F2}}"
                                        FontSize="16"
                                        HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

            <!-- Cart -->
            <StackPanel Grid.Column="2">
                <TextBlock
        Text="Current Order"
        FontSize="24"
        Margin="10"/>
                <ItemsControl ItemsSource="{Binding CartItems}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>
                            <Border
        BorderBrush="LightGray"
        BorderThickness="0,0,0,1"
        Padding="10">

                                <StackPanel>

                                    <!-- Product name -->
                                    <TextBlock
                Text="{Binding Product.Name}"
                FontSize="18"
                FontWeight="Bold"/>

                                    <!-- Unit price -->
                                    <TextBlock
                Text="{Binding Product.Price, StringFormat=RM {0:F2}}"
                FontSize="14"/>

                                    <!-- Quantity controls -->
                                    <StackPanel
                Orientation="Horizontal"
                Margin="0,8,0,0">

                                        <Button
                    Content="-"
                    Width="35"
                    Height="30"
                    Command="{Binding DataContext.DecreaseQuantityCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

                                        <TextBlock
                    Text="{Binding Quantity}"
                    Width="40"
                    FontSize="18"
                    TextAlignment="Center"
                    VerticalAlignment="Center"/>

                                        <Button
                    Content="+"
                    Width="35"
                    Height="30"
                    Command="{Binding DataContext.IncreaseQuantityCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

                                        <Button
                    Content="Remove"
                    Margin="10,0,0,0"
                    Command="{Binding DataContext.RemoveFromCartCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"/>

                                    </StackPanel>

                                    <!-- Subtotal -->
                                    <TextBlock
                Text="{Binding Subtotal, StringFormat=Subtotal: RM {0:F2}}"
                FontSize="16"
                Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>
                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </StackPanel>

        </Grid>

        <!-- Footer -->
        <TextBlock
    Text="{Binding Total, StringFormat=Total: RM {0:F2}}"
    FontSize="28"
    HorizontalAlignment="Right"
    Margin="20"
    Grid.Row="2"/>

    </Grid>

</Window>